{
  "uid": "roletailor-ai-quality",
  "title": "RoleTailor AI quality and cost (SQL)",
  "tags": [
    "roletailor",
    "ai",
    "postgres"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily cost per generation (completed): average and p95",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS time, avg_cost_usd AS \"average\", p95_cost_usd AS \"p95\"\nFROM roletailor_ops.generations_daily\nWHERE $__timeFilter(day) AND status = 'completed'\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fabrication attempt rate by day",
      "description": "Attempts caught by the fabrication gates, not escapes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS time, fabrication_attempt_rate AS \"attempt rate\"\nFROM roletailor_ops.generations_daily\nWHERE $__timeFilter(day) AND status = 'completed'\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Flagged rate by rule (validation_daily)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS time, rule_key AS metric,\n       sum(flagged_blocks)::float / NULLIF(sum(planned_blocks), 0) AS flagged_rate\nFROM roletailor_ops.validation_daily\nWHERE $__timeFilter(day)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI spend per hour by model",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, provider || ' / ' || model AS metric, sum(cost_usd) AS cost_usd\nFROM roletailor_ops.ai_calls_hourly\nWHERE $__timeFilter(bucket)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Release quality by prompt version and model",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT prompt_key, prompt_version, provider, model,\n       sum(calls) AS calls,\n       sum(failure_rate * calls) / NULLIF(sum(calls), 0) AS failure_rate,\n       sum(fallback_rate * calls) / NULLIF(sum(calls), 0) AS fallback_rate,\n       sum(avg_cost_usd * calls) / NULLIF(sum(calls), 0) AS avg_cost_usd,\n       max(p95_latency_ms) AS p95_latency_ms\nFROM roletailor_ops.release_quality_daily\nWHERE $__timeFilter(day)\nGROUP BY 1, 2, 3, 4\nORDER BY calls DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failure_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fallback_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95_latency_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top organizations by cost (ids only)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT organization_id::text AS organization_id, sum(generations) AS generations, sum(cost_usd) AS cost_usd\nFROM roletailor_ops.cost_by_org_daily\nWHERE $__timeFilter(day)\nGROUP BY 1\nORDER BY cost_usd DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Slowest recent generations",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "roletailor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roletailor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at, workflow_id::text AS workflow_id, status, wall_seconds, iterations, ai_calls, failed_calls, fallback_calls, cost_usd\nFROM roletailor_ops.generations\nWHERE $__timeFilter(started_at)\nORDER BY wall_seconds DESC NULLS LAST\nLIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "wall_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    }
  ]
}
