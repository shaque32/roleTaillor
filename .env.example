# RoleTailor configuration. Copy to .env; every RT_ variable maps to a field in
# backend/roletailor/config.py. docker-compose.yml overrides the connection URLs.

# --- Runtime ------------------------------------------------------------------
RT_ENVIRONMENT=dev                 # dev | staging | prod; selects prompt_versions.environment
RT_LOG_LEVEL=INFO

# --- Database and queue ---------------------------------------------------------
# The app and worker connect as rt_app (NOBYPASSRLS). Migrations run as the schema owner.
RT_DATABASE_URL=postgresql+psycopg://rt_app:rt_app@localhost:5432/roletailor
RT_MIGRATION_DATABASE_URL=postgresql://rt_owner:rt_owner@localhost:5432/roletailor
RT_REDIS_URL=redis://localhost:6379/0     # Celery broker, rate limits, LLM response cache
RT_CELERY_TASK_ALWAYS_EAGER=false         # true runs tasks inline (tests only)
RT_WORKER_METRICS_PORT=9101               # worker Prometheus endpoint; 0 disables

# --- AI providers -----------------------------------------------------------------
RT_LLM_MODE=live                   # live | fake (deterministic offline provider)
RT_MODELS_CONFIG_PATH=config/models.yaml
RT_LLM_CACHE_TTL_SECONDS=604800
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Public URLs ------------------------------------------------------------------
RT_API_BASE_URL=http://localhost:8000     # share links and local signed download URLs
RT_APP_BASE_URL=http://localhost:3000     # Stripe checkout success/cancel redirects
RT_CORS_ORIGINS=["http://localhost:3000"]

# --- Security -----------------------------------------------------------------------
RT_SECRET_KEY=change-me-to-a-long-random-string   # HMAC key for local signed URLs
# RT_SECRET_KEY must be 32+ characters outside dev/test (startup fails otherwise).
RT_SESSION_TTL_HOURS=336
RT_RATE_LIMIT_AUTH_PER_MINUTE=10
RT_RATE_LIMIT_GENERATION_PER_MINUTE=20

# --- File storage -------------------------------------------------------------------
RT_STORAGE_BACKEND=local           # local | s3
RT_STORAGE_LOCAL_DIR=.data/files
RT_S3_BUCKET=roletailor-files      # versioning should be enabled on the bucket
RT_S3_REGION=us-east-1
RT_S3_ENDPOINT_URL=                # e.g. http://minio:9000; empty uses AWS
RT_SIGNED_URL_TTL_SECONDS=900
RT_MAX_UPLOAD_BYTES=10485760
RT_SHARE_LINK_MAX_HOURS=720

# --- Job URL fetching ------------------------------------------------------------------
RT_JOB_FETCH_TIMEOUT_SECONDS=10
RT_JOB_FETCH_MAX_BYTES=2097152

# --- Generation -----------------------------------------------------------------------
RT_DEFAULT_PAGE_LIMIT=2

# --- Billing (Stripe) -------------------------------------------------------------------
RT_STRIPE_SECRET_KEY=
RT_STRIPE_WEBHOOK_SECRET=
RT_STRIPE_SUBSCRIPTION_PRICE_ID=   # the $9.99/month price
RT_STRIPE_PAY_PER_USE_PRICE_ID=    # optional; empty uses inline price data for the amount below
RT_PAY_PER_USE_AMOUNT_MINOR=50

# --- Documents ---------------------------------------------------------------------------
RT_SOFFICE=                        # optional path to LibreOffice; defaults to soffice on PATH
RT_TESSERACT=                      # optional path to Tesseract (OCR for scanned PDFs); defaults to tesseract on PATH

# --- Monitoring (docker-compose.monitoring.yml; see docs/monitoring.md) ----------------------
GRAFANA_ADMIN_PASSWORD=            # Grafana admin login
RT_METRICS_DB_PASSWORD=rt_metrics  # password of the read-only rt_metrics role (ops views)
