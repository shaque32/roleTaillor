# Non-secret settings. REPLACE the example.com placeholder domains with real ones (and
# attach them with `fly certs add`) before the first deploy.
RT_ENVIRONMENT=staging
RT_API_BASE_URL=https://api.staging.roletailor.example
RT_APP_BASE_URL=https://app.staging.roletailor.example
RT_CORS_ORIGINS=["https://app.staging.roletailor.example"]
RT_S3_BUCKET=roletailor-files-staging
